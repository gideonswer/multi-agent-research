# ---- LLM ----
# Main model provider: groq | gemini | ollama | anthropic | openai
LLM_PROVIDER=groq
# Leave blank for the provider default (groq: llama-3.3-70b-versatile)
LLM_MODEL=
# Used if the main model errors or hits a rate limit. Leave blank to disable.
FALLBACK_PROVIDER=gemini
FALLBACK_MODEL=

# Free key: https://console.groq.com/keys
GROQ_API_KEY=
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional, paid: set LLM_PROVIDER=anthropic to use Claude
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ---- Web search ----
# duckduckgo (free, no key) | tavily (1,000 free credits/month)
SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=
RESULTS_PER_QUERY=5

# ---- Agents ----
MAX_SUB_QUESTIONS=4

# Fake LLM + fake search, no keys needed (for demos and CI)
MOCK_MODE=false
